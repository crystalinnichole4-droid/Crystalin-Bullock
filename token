<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crystalin Bullock</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">Collectible token world</p>
          <h1>Crystalin Bullock</h1>
        </div>
        <button id="randomTokenBtn" class="primary-btn">Buy blind token</button>
      </header>

      <main class="content-grid">
        <section class="panel left-panel">
          <div class="section-header">
            <h2>Token Catalog</h2>
            <span id="tokenCount" class="pill">0 revealed</span>
          </div>

          <div id="tokenGrid" class="token-grid"></div>
        </section>

        <section class="panel right-panel">
          <div class="section-header">
            <h2>World Map</h2>
            <span id="seasonBadge" class="pill alt">World status active</span>
          </div>

          <div id="map" class="map" aria-label="Crystalin Bullock world map"></div>
        </section>
      </main>

      <section class="panel reveal-panel">
        <div class="reveal-header">
          <div>
            <p class="eyebrow">Scan result</p>
            <h2 id="revealTitle">No token scanned yet</h2>
          </div>
          <button id="toggleEventBtn" class="secondary-btn">Toggle holiday chaos</button>
        </div>

        <div class="reveal-body">
          <div class="qr-box" id="qrBox">
            <div class="qr-code">QR</div>
          </div>

          <div class="reveal-copy">
            <p id="revealDefect" class="defect-text"></p>
            <p id="revealStory" class="story-text"></p>
            <div id="revealTags" class="tag-row"></div>
          </div>
        </div>
      </section>
    </div>

    <script src="app.js"></script>
  </body>
</html>